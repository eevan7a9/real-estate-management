  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "tailwind:init": "tailwindcss init",
    "generate:env": "node scripts/generate-environments.cjs",
    "tailwind:build": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind-generated.css",
    "tailwind:watch": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind-generated.css --watch",
    "ng": "ng",
    "start": "npm run generate:env -- --mode=development && ng serve",
    "build": "npm run generate:env -- --mode=production && ng build --configuration production",
    "build:development": "npm run generate:env -- --mode=development && ng build",
    "test": "npm run generate:env -- --mode=development && ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "ionic:serve": "npm run generate:env -- --mode=development && ng serve",
    "ionic:build": "npm run generate:env -- --mode=production && ng build --configuration production",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json,md}\""
  },
  "private": true,
