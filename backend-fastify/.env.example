PORT=8000
LOGGER=true
NODE_ENV="development" # development or production

# SALT=12 Not needed on Argon2
SECRET_KEY='secret'

# Database connection string for MongoDB
DB_CONNECT=mongodb://localhost:27017/database-name

# Maximum number of user activities to store
USER_ACTIVITIES_MAX=25

# Maximum number of user notifications to store
USER_NOTIFICATIONS_MAX=25

# Optional notification expiration in days. Leave unset for notifications that do not expire.
USER_NOTIFICATION_EXPIRATION_DAYS=150

# OPTIONAL for GOOGLE SIGNIN
GOOGLE_AUTH_CLIENT_ID=605759104733-sclhebob93cp38n2186ho9qlfm6mb795.apps.googleusercontent.com

# Access JWT expiration time
JWT_EXPIRES_IN="15m"

# Refresh session duration
REFRESH_TOKEN_EXPIRES_IN="14d"

# Comma-separated web/WebView origins permitted to send credentialed requests.
# Include http://localhost for Capacitor Android.
FRONTEND_ORIGINS="https://app.example.com,http://localhost"

# Refresh-cookie policy for local HTTP development.
REFRESH_COOKIE_SAME_SITE="lax"
REFRESH_COOKIE_SECURE="false"

# For Capacitor or cross-site HTTPS API deployments, change both values to:
# REFRESH_COOKIE_SAME_SITE="none"
# REFRESH_COOKIE_SECURE="true"
