PORT=8000
LOGGER=true
NODE_ENV="development" # development or production

# SALT=12 Not needed on Argon2
SECRET_KEY='secret'
DB_CONNECT=mongodb://localhost:27017/database-name
USER_ACTIVITIES_MAX=20
USER_NOTIFICATIONS_MAX=30
# OPTIONAL for GOOGLE SIGNIN
GOOGLE_AUTH_CLIENT_ID=xxxxxx-xxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com